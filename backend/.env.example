# StressGuard Backend Environment Configuration

# Security Secret Key for JWT token signing
SECRET_KEY=btech_cse_stress_detection_secret_key_2026_secured

# Database Connection (default: SQLite)
DATABASE_URL=sqlite:///stress_system.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/stress_db

# CORS Allowed Origins (comma-separated list for custom domains/production hosts)
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5174
